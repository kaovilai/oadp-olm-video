    "lint": "eslint src && tsc && prettier --check components layouts styles .github/workflows/pages.yml",
    "video:dev": "remotion studio",
    "video:build": "remotion bundle",
    "video:upgrade": "remotion upgrade"
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "allowScripts": {
    "esbuild": false
